# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Worker Pool
WORKER_MIN_THREADS=2
WORKER_MAX_THREADS=4
WORKER_IDLE_TIMEOUT=60000
WORKER_MAX_QUEUE=100
WORKER_TASK_TIMEOUT=45000

# Fhenix CoFHE Network (Arbitrum Sepolia)
COFHE_CHAIN_ID=421614
COFHE_NETWORK_NAME="Arbitrum Sepolia"
COFHE_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
COFHE_ENV=testnet

# Alternative: Ethereum Sepolia
# COFHE_CHAIN_ID=11155111
# COFHE_RPC_URL=https://eth-sepolia.public.blastapi.io
